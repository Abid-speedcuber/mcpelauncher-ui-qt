+static bool makeMinecraftMemoryWritable(uintptr_t address, size_t size, int protection) {
+#if defined(__i386__) || defined(__x86_64__)
+    long pageSize = sysconf(_SC_PAGESIZE);
+    if(pageSize <= 0)
+        return false;
+
+    auto page = address & ~(static_cast<uintptr_t>(pageSize) - 1);
+    auto pageEnd = (address + size + pageSize - 1) & ~(static_cast<uintptr_t>(pageSize) - 1);
+    return mprotect(reinterpret_cast<void*>(page), pageEnd - page, protection) == 0;
+#else
+    (void)address;
+    (void)size;
+    (void)protection;
+    return false;
+#endif
+}
+
+static bool patchMinecraftBytes(void* handle, uintptr_t offset, const unsigned char* expected, const unsigned char* replacement, size_t size, const char* name) {
+#if defined(__i386__) || defined(__x86_64__)
+    auto base = reinterpret_cast<uintptr_t>(MinecraftUtils::getLibraryBase(handle));
+    auto address = base + offset;
+    if(std::memcmp(reinterpret_cast<void*>(address), expected, size) != 0) {
+        Log::warn("Launcher", "Skipped %s patch: byte pattern mismatch at 0x%zx", name, static_cast<size_t>(offset));
+        return false;
+    }
+
+    if(!makeMinecraftMemoryWritable(address, size, PROT_READ | PROT_WRITE | PROT_EXEC)) {
+        Log::warn("Launcher", "Failed to make Minecraft code writable for %s patch", name);
+        return false;
+    }
+
+    std::memcpy(reinterpret_cast<void*>(address), replacement, size);
+    __builtin___clear_cache(reinterpret_cast<char*>(address), reinterpret_cast<char*>(address + size));
+    makeMinecraftMemoryWritable(address, size, PROT_READ | PROT_EXEC);
+    Log::info("Launcher", "Applied %s patch at 0x%zx", name, static_cast<size_t>(offset));
+    return true;
+#else
+    (void)handle;
+    (void)offset;
+    (void)expected;
+    (void)replacement;
+    (void)size;
+    (void)name;
+    return false;
+#endif
+}
+
+static int normalizedHighSimulationChunks() {
+    int chunks = Settings::high_distance_simulation_chunks;
+    if(chunks < 4)
+        chunks = 4;
+    if(chunks > 126)
+        chunks = 126;
+    if((chunks % 2) != 0)
+        --chunks;
+    return chunks;
+}
+
+static int highSimulationOptionCount(void*) {
+    return ((normalizedHighSimulationChunks() - 4) / 2) + 1;
+}
+
+static int highSimulationChunksFromIndex(int index) {
+    int count = highSimulationOptionCount(nullptr);
+    if(index < 0)
+        index = 0;
+    if(index >= count)
+        index = count - 1;
+    return 4 + (index * 2);
+}
+
+static int* getSimulationDistanceSetting(void* provider) {
+    if(provider == nullptr)
+        return nullptr;
+
+    auto wrapper = *reinterpret_cast<uintptr_t*>(reinterpret_cast<uintptr_t>(provider) + 0x50);
+    if(wrapper == 0)
+        return nullptr;
+
+    auto settings = *reinterpret_cast<uintptr_t*>(wrapper + 0x10);
+    if(settings == 0)
+        settings = wrapper + 0x18;
+
+    return reinterpret_cast<int*>(settings + 0x310);
+}
+
+static int highSimulationCurrentIndex(void* provider) {
+    int* setting = getSimulationDistanceSetting(provider);
+    int chunks = setting != nullptr ? *setting : Settings::high_distance_simulation_chunks;
+    if(chunks < 4)
+        chunks = 4;
+    if(chunks > normalizedHighSimulationChunks())
+        chunks = normalizedHighSimulationChunks();
+    if((chunks % 2) != 0)
+        --chunks;
+    return (chunks - 4) / 2;
+}
+
+static void highSimulationSetIndex(void* provider, int index) {
+    int* setting = getSimulationDistanceSetting(provider);
+    if(setting == nullptr) {
+        Log::warn("Launcher", "Simulation distance provider hook could not find the LevelData setting");
+        return;
+    }
+
+    int chunks = highSimulationChunksFromIndex(index);
+    *setting = chunks;
+    Log::info("Launcher", "Simulation distance provider hook set distance to %d chunks", chunks);
+}
+
+static bool patchMinecraftPointer(void* handle, uintptr_t offset, uintptr_t expectedOffset, void* replacement, const char* name) {
+#if defined(__i386__) || defined(__x86_64__)
+    auto base = reinterpret_cast<uintptr_t>(MinecraftUtils::getLibraryBase(handle));
+    auto address = base + offset;
+    auto expected = reinterpret_cast<void*>(base + expectedOffset);
+    auto current = *reinterpret_cast<void**>(address);
+    if(current != expected) {
+        Log::warn("Launcher", "Skipped %s hook: pointer mismatch at 0x%zx (current=%p expected=%p)",
+                  name, static_cast<size_t>(offset), current, expected);
+        return false;
+    }
+
+    if(!makeMinecraftMemoryWritable(address, sizeof(void*), PROT_READ | PROT_WRITE)) {
+        Log::warn("Launcher", "Failed to make Minecraft data writable for %s hook", name);
+        return false;
+    }
+
+    *reinterpret_cast<void**>(address) = replacement;
+    makeMinecraftMemoryWritable(address, sizeof(void*), PROT_READ);
+    Log::info("Launcher", "Applied %s hook at 0x%zx", name, static_cast<size_t>(offset));
+    return true;
+#else
+    (void)handle;
+    (void)offset;
+    (void)expectedOffset;
+    (void)replacement;
+    (void)name;
+    return false;
+#endif
+}
+
+void forceHighSimulationDistance(void* handle) {
+    if(!Settings::enable_high_distance_options || Settings::high_distance_simulation_chunks <= 8 || Settings::high_distance_simulation_chunks > 127)
+        return;
+
+    unsigned char expected[] = {0xff, 0x90, 0x70, 0x07, 0x00, 0x00};
+    unsigned char replacement[] = {0xb8, static_cast<unsigned char>(Settings::high_distance_simulation_chunks), 0x00, 0x00, 0x00, 0x90};
+    patchMinecraftBytes(handle, 0xb954be7, expected, replacement, sizeof(expected), "simulation distance max");
+    patchMinecraftBytes(handle, 0xa3ecb15, expected, replacement, sizeof(expected), "OreUI simulation distance options max");
+    patchMinecraftPointer(handle, 0x14a215a8, 0xb957230, reinterpret_cast<void*>(highSimulationOptionCount), "simulation distance option count");
+    patchMinecraftPointer(handle, 0x14a215b0, 0xb957280, reinterpret_cast<void*>(highSimulationCurrentIndex), "simulation distance current index");
+    patchMinecraftPointer(handle, 0x14a215b8, 0xb957390, reinterpret_cast<void*>(highSimulationSetIndex), "simulation distance setter");
+    Log::info("Launcher", "Simulation distance provider hook exposes %d options up to %d chunks",
+              highSimulationOptionCount(nullptr), normalizedHighSimulationChunks());
+}
+
 void applyHighDistanceOptions() {
     if(!Settings::enable_high_distance_options)
         return;
@@ -778,6 +938,7 @@ void applyHighDistanceOptions() {
     properties::property<int> particleViewDistance(properties, "gfx_particleviewdistance", 0);
     properties::property<int> rayTracingViewDistance(properties, "raytracing_viewdistance", 0);
