+static bool makeMinecraftMemoryWritable(uintptr_t address, size_t size, int protection) {
+#if defined(__i386__) || defined(__x86_64__)
+    if(size == 0 || address + size < address)
+        return false;
+
+    long pageSize = sysconf(_SC_PAGESIZE);
+    if(pageSize <= 0)
+        return false;
+
+    auto page = address & ~(static_cast<uintptr_t>(pageSize) - 1);
+    auto end = address + size;
+    if(end + static_cast<uintptr_t>(pageSize) - 1 < end)
+        return false;
+    auto pageEnd = (end + static_cast<uintptr_t>(pageSize) - 1) & ~(static_cast<uintptr_t>(pageSize) - 1);
+    return mprotect(reinterpret_cast<void*>(page), pageEnd - page, protection) == 0;
+#else
+    (void)address;
+    (void)size;
+    (void)protection;
+    return false;
+#endif
+}
+
+static bool isMinecraftMemoryReadable(uintptr_t address, size_t size) {
+#if defined(__i386__) || defined(__x86_64__)
+    if(size == 0 || address + size < address)
+        return false;
+
+    std::ifstream maps("/proc/self/maps");
+    std::string line;
+    while(std::getline(maps, line)) {
+        auto dash = line.find('-');
+        auto space = line.find(' ', dash + 1);
+        if(dash == std::string::npos || space == std::string::npos || space + 1 >= line.size())
+            continue;
+
+        try {
+            auto start = static_cast<uintptr_t>(std::stoull(line.substr(0, dash), nullptr, 16));
+            auto end = static_cast<uintptr_t>(std::stoull(line.substr(dash + 1, space - dash - 1), nullptr, 16));
+            if(line[space + 1] == 'r' && address >= start && address + size <= end)
+                return true;
+        } catch(...) {
+            continue;
+        }
+    }
+    return false;
+#else
+    (void)address;
+    (void)size;
+    return false;
+#endif
+}
+
+static bool patchMinecraftBytes(void* handle, uintptr_t offset, const unsigned char* expected, const unsigned char* replacement, size_t size, const char* name) {
+#if defined(__i386__) || defined(__x86_64__)
+    auto base = reinterpret_cast<uintptr_t>(MinecraftUtils::getLibraryBase(handle));
+    auto address = base + offset;
+    if(address < base || !isMinecraftMemoryReadable(address, size)) {
+        Log::warn("Launcher", "Skipped %s patch: target address 0x%zx is not mapped/readable", name, static_cast<size_t>(offset));
+        return false;
+    }
+
+    if(std::memcmp(reinterpret_cast<void*>(address), expected, size) != 0) {
+        Log::warn("Launcher", "Skipped %s patch: byte pattern mismatch at 0x%zx", name, static_cast<size_t>(offset));
+        return false;
+    }
+
+    if(!makeMinecraftMemoryWritable(address, size, PROT_READ | PROT_WRITE | PROT_EXEC)) {
+        Log::warn("Launcher", "Failed to make Minecraft code writable for %s patch", name);
+        return false;
+    }
+
+    std::memcpy(reinterpret_cast<void*>(address), replacement, size);
+    __builtin___clear_cache(reinterpret_cast<char*>(address), reinterpret_cast<char*>(address + size));
+    makeMinecraftMemoryWritable(address, size, PROT_READ | PROT_EXEC);
+    Log::info("Launcher", "Applied %s patch at 0x%zx", name, static_cast<size_t>(offset));
+    return true;
+#else
+    (void)handle;
+    (void)offset;
+    (void)expected;
+    (void)replacement;
+    (void)size;
+    (void)name;
+    return false;
+#endif
+}
+
+static int normalizedHighSimulationChunks() {
+    int chunks = Settings::high_distance_simulation_chunks;
+    if(chunks < 4)
+        chunks = 4;
+    if(chunks > 126)
+        chunks = 126;
+    if((chunks % 2) != 0)
+        --chunks;
+    return chunks;
+}
+
+void forceHighSimulationDistance(void* handle) {
+    if(!Settings::enable_high_distance_options || Settings::high_distance_simulation_chunks <= 8 || Settings::high_distance_simulation_chunks > 127)
+        return;
+
+    unsigned char expected[] = {0xff, 0x90, 0x70, 0x07, 0x00, 0x00};
+    unsigned char replacement[] = {0xb8, static_cast<unsigned char>(Settings::high_distance_simulation_chunks), 0x00, 0x00, 0x00, 0x90};
+    patchMinecraftBytes(handle, 0xb954be7, expected, replacement, sizeof(expected), "simulation distance max");
+    patchMinecraftBytes(handle, 0xa3ecb15, expected, replacement, sizeof(expected), "OreUI simulation distance options max");
+    Log::info("Launcher", "Simulation distance max patches expose options up to %d chunks",
+              normalizedHighSimulationChunks());
+}
+
 void applyHighDistanceOptions() {
     if(!Settings::enable_high_distance_options)
         return;
@@ -792,6 +907,7 @@ void applyHighDistanceOptions() {
     properties::property<int> particleViewDistance(properties, "gfx_particleviewdistance", 0);
     properties::property<int> rayTracingViewDistance(properties, "raytracing_viewdistance", 0);
     properties::property<int> deferredViewDistance(properties, "deferred_viewdistance", 0);
+    properties::property<int> simDistance(properties, "simulationdistance", 0);
     properties::property<int> memoryTierOverride(properties, "device_info_memory_tier_override", 0);
     properties::property<bool> useMemoryTierOverride(properties, "device_info_use_memory_tier_override", false);
     properties::property<bool> showRenderDistanceWarning(properties, "show_render_distance_warning_modal", false);
@@ -816,13 +932,15 @@ void applyHighDistanceOptions() {
     seedInt("gfx_particleviewdistance", particleViewDistance, Settings::high_distance_particle_chunks);
     seedInt("raytracing_viewdistance", rayTracingViewDistance, Settings::high_distance_raytracing_chunks);
     seedInt("deferred_viewdistance", deferredViewDistance, Settings::high_distance_deferred_chunks);
+    seedInt("simulationdistance", simDistance, Settings::high_distance_simulation_chunks);
     seedInt("device_info_memory_tier_override", memoryTierOverride, Settings::high_distance_memory_tier);
     setBool(useMemoryTierOverride, true);
     setBool(showRenderDistanceWarning, false);
 
     if(changed) {
-        Log::info("Launcher", "Applied high distance options: render=%d, particles=%d, memory tier=%d",
-                  Settings::high_distance_render_chunks, Settings::high_distance_particle_chunks, Settings::high_distance_memory_tier);
+        Log::info("Launcher", "Applied high distance options: render=%d, sim=%d, particles=%d, memory tier=%d",
+                  Settings::high_distance_render_chunks, Settings::high_distance_simulation_chunks,
+                  Settings::high_distance_particle_chunks, Settings::high_distance_memory_tier);
         saveOptions(properties);
     }
 }
