 mcpelauncher-client/src/main.cpp     | 57 +++++++++++++++++++++++++--
 mcpelauncher-client/src/settings.cpp |  5 +++
 mcpelauncher-client/src/settings.h   |  1 +
 3 files changed, 59 insertions(+), 4 deletions(-)

diff --git a/mcpelauncher-client/src/main.cpp b/mcpelauncher-client/src/main.cpp
