+static void runDistanceDiagnostics(void* handle) {
+    Log::info("DistanceDiag", "begin");
+    auto mappings = getMinecraftMappings();
+    size_t codeBase = 0;
+    size_t codeSize = 0;
+    linker::get_library_code_region(handle, codeBase, codeSize);
+    Log::info("DistanceDiag", "code region %p size 0x%zx", (void*)codeBase, codeSize);
+
+    static const char* needles[] = {
+        "options.renderDistance",
+        "options.renderDistanceFormat",
+        "options.renderDistanceRecommendedFormat",
+        "maximumRenderDistance",
+        "maxRenderDistance",
+        "viewDistanceChunks",
+        "defaultRenderDistance",
+        "render_distance_levels",
+        "gfx_viewdistance",
+        "gfx_renderdistance",
+        "query.client_max_render_distance",
+        "simulationDistance",
+        "simulationDistanceOptions",
+        "vanilla.simulationDistanceOptions",
+        "memory_performance_tier",
+        "graphicsDeviceTier",
+        "memoryDeviceTier",
+        "hardwareMemoryTier",
+        "device_info_memory_tier_override",
+    };
+
+    for(const char* needle : needles) {
+        uintptr_t found = 0;
+        for(const auto& mapping : mappings) {
+            found = findNeedleInMapping(mapping, needle);
+            if(found)
+                break;
+        }
+        if(!found) {
+            Log::info("DistanceDiag", "needle '%s' not found", needle);
+            continue;
+        }
+        Log::info("DistanceDiag", "needle '%s' at %p rel 0x%zx", needle, (void*)found, found - MinecraftUtils::getLibraryBase(handle));
+        auto xrefs = findRipRelativeXrefs(codeBase, codeSize, found);
+        Log::info("DistanceDiag", "needle '%s' xrefs %zu", needle, xrefs.size());
+        for(size_t i = 0; i < xrefs.size() && i < 16; ++i) {
+            Log::info("DistanceDiag", "  xref[%zu] %p rel 0x%zx", i, (void*)xrefs[i], xrefs[i] - MinecraftUtils::getLibraryBase(handle));
+            logCodeBytes(xrefs[i]);
+        }
+    }
+
+    properties::property_list properties(':');
+    properties::property<int> gfxViewDistance(properties, "gfx_viewdistance", -1);
+    properties::property<int> gfxRenderDistance(properties, "gfx_renderdistance", -1);
+    properties::property<int> simDistance(properties, "simulationdistance", -1);
+    properties::property<int> serverViewDistance(properties, "server_viewdistance", -1);
+    properties::property<int> memoryTier(properties, "device_info_memory_tier_override", -1);
+    parseOptions(properties);
+    Log::info("DistanceDiag", "options gfx_viewdistance=%d gfx_renderdistance=%d simulationdistance=%d server_viewdistance=%d memory_tier_override=%d",
+              gfxViewDistance.get(), gfxRenderDistance.get(), simDistance.get(), serverViewDistance.get(), memoryTier.get());
+    Log::info("DistanceDiag", "end");
+}
